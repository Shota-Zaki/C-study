const toc=[...document.querySelectorAll('.right-toc a[href^="#"]')],sections=toc.map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);if(sections.length){const ob=new IntersectionObserver(es=>{const e=es.filter(x=>x.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top)[0];if(!e)return;toc.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+e.target.id))},{rootMargin:'-20% 0px -70% 0px'});sections.forEach(s=>ob.observe(s));}
